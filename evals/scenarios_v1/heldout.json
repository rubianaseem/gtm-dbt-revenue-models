{
  "version": "scenarios_v1/heldout",
  "note": "Held-out scenarios. Written and hashed (scenarios_v1.sha256) before any tuning on dev; never used to change rules.",
  "scenarios": [
    {"id": "H01", "title": "Tasks connector stale (no exposure depends on it)",
     "mutations": [{"op": "sync_lag", "table": "raw_salesforce.tasks", "hours": 60}],
     "expect": {"issues": [["stale_source", "salesforce.tasks"]], "hold": false}},
    {"id": "H02", "title": "HubSpot email property renamed to email_address",
     "mutations": [{"op": "rename_column", "table": "hubspot__contacts", "old": "email", "new": "email_address"}],
     "expect": {"issues": [["schema_drift", "hubspot.contacts"]], "hold": true, "fix": {"candidate_column": "email_address"}},
     "verify_fix": {"held": "all", "values": {}}},
    {"id": "H03", "title": "Identical stage-history rows duplicated by a re-sync",
     "mutations": [{"op": "duplicate_rows", "table": "salesforce__opportunity_history", "every": 30, "limit": 8}],
     "expect": {"issues": [["duplicate_keys", "salesforce.opportunity_history"]], "hold": true, "fix": {"duplicate_conflicting": 0}}},
    {"id": "H04", "title": "Current stage 'Verbal Commit' appears on opportunities",
     "mutations": [{"op": "set_value", "table": "salesforce__opportunities", "column": "stage_name", "value": "Verbal Commit", "every": 35, "start": 4}],
     "expect": {"issues": [["unmapped_stage", "salesforce.opportunities"]], "hold": true, "fix": {"requires_human_input": ["stage:verbal commit"]}},
     "verify_fix": {"held": "all", "values": {"stage:verbal commit": "Negotiation"}}},
    {"id": "H05", "title": "Currency typo GPB",
     "mutations": [{"op": "set_value", "table": "salesforce__opportunities", "column": "currency_iso_code", "value": "GPB", "every": 45, "start": 6}],
     "expect": {"issues": [["missing_fx_rate", "salesforce.opportunities"]], "hold": true, "fix": {"requires_human_input": ["rate_to_usd:GPB"]}}},
    {"id": "H06", "title": "History timestamps shifted 30 days earlier by an offset bug",
     "mutations": [{"op": "transform", "table": "salesforce__opportunity_history", "column": "created_date", "fn": "minus_30_days", "every": 9}],
     "expect": {"issues": [["timezone_or_date_drift", "salesforce.opportunity_history"]], "hold": true}},
    {"id": "H07", "title": "Amounts in pence on a block of deals (no test fails)",
     "mutations": [{"op": "transform", "table": "salesforce__opportunities", "column": "amount", "fn": "times_100", "every": 8, "start": 3}],
     "expect": {"issues": [["metric_shift", "salesforce.opportunities"]], "hold": true}},
    {"id": "H08", "title": "Touches with blank contact ids (warn-level test)",
     "mutations": [{"op": "set_value", "table": "hubspot__touches", "column": "contact_id", "value": "", "every": 25}],
     "expect": {"issues": [["orphan_reference", "hubspot.touches"]], "hold": false}},
    {"id": "H09", "title": "A pull request renames a contracted column",
     "mutations": [{"op": "code_replace", "file": "models/marts/rpt_owner_coverage.sql",
                    "old": "end                                                                      as coverage_flag",
                    "new": "end                                                                      as coverage_status"}],
     "expect": {"issues": [["contract_breach", "rpt_owner_coverage"]], "hold": true}},
    {"id": "H10", "title": "Opportunities stale and AUD deals at once",
     "mutations": [{"op": "sync_lag", "table": "raw_salesforce.opportunities", "hours": 50},
                   {"op": "set_value", "table": "salesforce__opportunities", "column": "currency_iso_code", "value": "AUD", "every": 30, "start": 1}],
     "expect": {"issues": [["stale_source", "salesforce.opportunities"], ["missing_fx_rate", "salesforce.opportunities"]], "hold": true}}
  ]
}
